# Claves de API (como mínimo, dos de las tres)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Modelos (opcionales; compruebe los identificadores vigentes en la documentación de cada proveedor)
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5
PERPLEXITY_PRESET=sonar-pro

# Opcional: limita la búsqueda web de Perplexity a fuentes oficiales (separadas por comas)
PERPLEXITY_DOMINIOS=boe.es,poderjudicial.es,agenciatributaria.es,hacienda.gob.es,petete.tributos.hacienda.gob.es,serviciostelematicosext.hacienda.gob.es,eur-lex.europa.eu,curia.europa.eu,tribunalconstitucional.es

# Interfaz web
COUNCIL_HOST=127.0.0.1
COUNCIL_PORT=8000
COUNCIL_SALIDAS=salidas
