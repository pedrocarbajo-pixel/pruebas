# Claves de API (como mínimo, dos de las tres)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Modelos: se gestionan en council/modelos.py, que se revisa y actualiza periódicamente.
# Descomente una línea solo para forzar un modelo concreto (admite listas de reserva separadas por comas);
# mientras esté activa, las actualizaciones periódicas no afectarán a ese miembro.
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6.1-sol,gpt-6-sol
# PERPLEXITY_PRESET=sonar-pro
# CLAUDE_MODEL_EXTREMO=claude-opus-5-5
# OPENAI_MODEL_EXTREMO=gpt-6-astra
# PERPLEXITY_PRESET_EXTREMO=sonar-reasoning

# Nivel EXTREMO: escala de esfuerzo, de mayor a menor. Si la API rechaza un esfuerzo, se prueba
# el siguiente; el informe indica el que se usó realmente.
CLAUDE_ESFUERZO_EXTREMO=max,xhigh,high
OPENAI_ESFUERZO_EXTREMO=max,xhigh,high
PERPLEXITY_ESFUERZO_EXTREMO=xhigh,high

# Búsqueda web de los tres miembros (1 = activada, 0 = desactivada)
BUSQUEDA_WEB=1
# Opcional: limita la búsqueda web a fuentes oficiales (separadas por comas).
# Si no se define, se usa PERPLEXITY_DOMINIOS (nombre anterior de esta variable).
BUSQUEDA_DOMINIOS=boe.es,poderjudicial.es,agenciatributaria.es,hacienda.gob.es,petete.tributos.hacienda.gob.es,serviciostelematicosext.hacienda.gob.es,eur-lex.europa.eu,curia.europa.eu,tribunalconstitucional.es

# Interfaz web
COUNCIL_HOST=127.0.0.1
COUNCIL_PORT=8000
COUNCIL_SALIDAS=salidas
